{
  "name": "nestjs-hexagonal-template",
  "version": "0.0.1",
  "description": "Template de backend Node.js com NestJS, arquitetura modular, PostgreSQL, Drizzle e Vitest",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "predev": "docker compose up -d",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=.env --import ./dist/instrumentation.js\"",
    "start": "node --env-file-if-exists=.env --import ./dist/instrumentation.js dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest --project unit",
    "verify": "npm run lint && npm run typecheck && npm run db:check && npm run test && npm run build"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.2",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@swc/core": "^1.16.13",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "testcontainers": "^12.2.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
