PORT=8080
DATABASE_URL=postgres://hexagonal_template:secret@localhost:5432/hexagonal_template
API_DOCS_ENABLED=true
LOG_LEVEL=debug

OTEL_SERVICE_NAME=nestjs-hexagonal-template
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none

# Identidade: "gateway" confia no header que o gateway grava; "jwt" valida o token aqui, por JWKS.
IDENTITY_MODE=gateway
IDENTITY_SUBJECT_HEADER=x-auth-subject
# JWT_JWKS_URL=https://<seu-app>.clerk.accounts.dev/.well-known/jwks.json
# JWT_ISSUER=https://<seu-app>.clerk.accounts.dev
# JWT_AUDIENCE=
# JWT_AUTHORIZED_PARTIES=
